# Backend environment (copy to .env and fill in real values)
# .env is git-ignored; never commit real secrets.

# --- Database ---------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/hrm_db
DB_USERNAME=hrm_app
DB_PASSWORD=change-me

# update | validate. Use validate in production once the schema is baselined.
DB_DDL_AUTO=update
JPA_SHOW_SQL=false

# --- Authentication ---------------------------------------------------------
# Must be at least 32 bytes: openssl rand -base64 48
JWT_SECRET=change-me-to-a-48-byte-random-string
JWT_EXPIRATION_MS=86400000

# Auth cookie: COOKIE_SECURE must be true in production (HTTPS only).
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- Browser / API ----------------------------------------------------------
# Comma separated origins of the deployed frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Sign-in abuse protection ----------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- First administrator (only used when the admins table is empty) ---------
# Minimum 12 characters, not a known default, not the email local part.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-at-least-12-chars
DEFAULT_ADMIN_NAME=Administrator
