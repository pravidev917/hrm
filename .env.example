# DEVELOPMENT environment (copy to .env, which is git-ignored).
# For production use deploy/backend.env.example instead — the two are not copies
# of each other: production pins the `prod` profile, validate and HTTPS cookies.
#
# Spring does not read .env by itself. Start the backend with:
#   set -a && . ./.env && set +a && ./mvnw spring-boot:run

# --- Database ---------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/hrm_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# update for development; production always uses validate.
DB_DDL_AUTO=update
JPA_SHOW_SQL=false
DB_POOL_SIZE=8

# --- Authentication ---------------------------------------------------------
# At least 32 bytes: openssl rand -base64 48
JWT_SECRET=change-me-to-a-48-byte-random-string
JWT_EXPIRATION_MS=86400000

# Local development is plain HTTP, so the cookie cannot be Secure here.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- Browser / API ----------------------------------------------------------
# Only needed when the SPA talks to a separately hosted API; day-to-day
# development goes through the Vite proxy (see frontend/vite.config.js).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Runtime ----------------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata
# Office attendance verification: reject browser fixes worse than this accuracy,
# and reject fixes older than this many seconds.
ATTENDANCE_MAX_ACCURACY_METERS=50
LOCATION_MAX_AGE_SECONDS=120
SERVER_PORT=8080
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# --- Sign-in abuse protection ----------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- First administrator (only used when the admins table is empty) ---------
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-at-least-12-chars
DEFAULT_ADMIN_NAME=Administrator

# --- Docker (docker-compose.yml / docker-compose.dev.yml) -------------------
# Compose reads this file for variable substitution; the containers ignore
# anything it does not map. DB_URL above is replaced by the compose network
# address (jdbc:postgresql://db:5432/<POSTGRES_DB>), so it is not used there.
# DB_PASSWORD is also the PostgreSQL superuser password of the db container.
# Optional overrides (defaults shown):
# POSTGRES_DB=hrm_db
# POSTGRES_USER=postgres
# HRM_HTTP_PORT=8080      # production-like stack, published SPA port
# HRM_API_PORT=8080       # dev stack, Spring Boot port
# HRM_WEB_PORT=5173       # dev stack, Vite port
# HRM_DB_PORT=55432       # dev stack, PostgreSQL exposed to the host
