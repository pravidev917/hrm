# DEVELOPMENT environment (copy to .env, which is git-ignored).
# For production use deploy/backend.env.example instead — the two are not copies
# of each other: production pins the `prod` profile, validate and HTTPS cookies.
#
# Spring does not read .env by itself. Start the backend with:
#   set -a && . ./.env && set +a && ./mvnw spring-boot:run

# --- Database ---------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/hrm_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# update for development; production always uses validate.
DB_DDL_AUTO=update
JPA_SHOW_SQL=false
DB_POOL_SIZE=8

# --- Authentication ---------------------------------------------------------
# At least 32 bytes: openssl rand -base64 48
JWT_SECRET=change-me-to-a-48-byte-random-string
JWT_EXPIRATION_MS=86400000

# Local development is plain HTTP, so the cookie cannot be Secure here.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- Browser / API ----------------------------------------------------------
# Only needed when the SPA talks to a separately hosted API; day-to-day
# development goes through the Vite proxy (see frontend/vite.config.js).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Runtime ----------------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata
SERVER_PORT=8080
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# --- Sign-in abuse protection ----------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- First administrator (only used when the admins table is empty) ---------
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-at-least-12-chars
DEFAULT_ADMIN_NAME=Administrator
