# Environment variables and secrets
.env
.env.*
!.env.example

# Node.js
node_modules/
dist/
npm-debug.log*

# Java / Maven
target/
*.class

# IDE
.idea/
*.iml

# Operating system
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log

# Certificates and private keys
*.pem
*.key
*.p12
*.pfx
*.jks

# release artefacts produced by deploy/scripts/build-release.*
build/

# packaged deliverables from deploy/scripts/build-release.*
handoff/

# packaged frontend build (Vercel builds its own from source)
/frontend.zip

# Vercel CLI state (.vercel/project.json holds the project id, not a secret,
# but it is per-machine and confusing in a shared repo)
.vercel/

# Deploy inputs that carry the database password and the JWT secret.
deploy/oracle/env/*.env
!deploy/oracle/env/*.example
