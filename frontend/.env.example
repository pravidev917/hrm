# Frontend environment.
#
# Vite variables are exposed to the browser: never put secrets here.
#
# LOCAL (default, empty): "same origin". The SPA calls /api/... and the dev
# server or the self-hosted nginx proxies it to Spring Boot. Nothing to set.
#
# VERCEL: the frontend and the backend are on different origins
# (hrm.vercel.app vs api.your-domain), so Vercel must inject the API origin at
# build time. Set it in the Vercel project, never in git:
#
#   Project -> Settings -> Environment Variables
#     VITE_API_BASE_URL = https://api.<your-domain>
#
# Vercel re-runs the build when the variable changes, so redeploy after editing.
# The backend must list the Vercel origin in CORS_ALLOWED_ORIGINS, and its auth
# cookie is SameSite=None; Secure (see deploy/oracle/env/*.backend.env.example).
#
# Development overrides usually go in .env.local (git-ignored), e.g.:
#   VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=
