# Frontend environment.
#
# Vite variables are exposed to the browser: never put secrets here.
#
# The default (empty) value means "same origin": the SPA calls /api/... and the
# reverse proxy (nginx in production, Vite's dev server in development) forwards
# it to Spring Boot. Leave this empty unless the API truly lives on another
# host.
#
# Development overrides usually go in .env.local (git-ignored), e.g.:
#   VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=