# Line endings matter for everything that runs on Linux: a CRLF shell script
# fails with "/usr/bin/env: 'bash\r': No such file or directory", and CRLF in a
# Dockerfile or nginx config produces confusing parse errors.

*.sh            text eol=lf
*.ps1           text eol=crlf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
*.conf          text eol=lf
*.template      text eol=lf
*.service       text eol=lf
*.sql           text eol=lf
.env.example    text eol=lf
*.example       text eol=lf

# Windows-only helpers keep CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf
