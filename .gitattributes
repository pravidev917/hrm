# Keep text files predictable across Windows and Linux contributors.
* text=auto

*.sql           text eol=lf
.env.example    text eol=lf
*.example       text eol=lf

# Windows-only helpers keep CRLF so double-clicking them works.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
