# Backend local development environment.
#
#   cp backend/.env.example backend/.env
#
# Spring Boot does not automatically load .env. Load these variables before
# starting the backend (see the root README for PowerShell and Git Bash commands).
#
# Never commit backend/.env; it contains database and JWT credentials.

# --- Database ---------------------------------------------------------------
# Create it first (see README):
#   createdb hrm_db
#   psql -d hrm_db -f docs/migrations/V1__baseline_schema.sql   (then V2..V5)
DB_URL=jdbc:postgresql://localhost:5432/hrm_db
DB_USERNAME=postgres
DB_PASSWORD=change-me
# update lets Hibernate adjust tables while you develop. Switch to validate once
# the migrations are the source of truth.
DB_DDL_AUTO=update
JPA_SHOW_SQL=false
DB_POOL_SIZE=8

# --- Authentication ---------------------------------------------------------
# At least 32 characters. Generate one: openssl rand -base64 48
JWT_SECRET=change-me-to-a-48-byte-random-string
JWT_EXPIRATION_MS=86400000

# Local development is plain http, so the cookie must not be Secure.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- Browser / API ----------------------------------------------------------
# The SPA normally talks to the API through the Vite proxy, which keeps the
# request same-origin. Only set this when the page is served from another port
# or host, and list exactly that origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- Runtime ----------------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata
# Reject browser locations that are less accurate than this, or older than this.
ATTENDANCE_MAX_ACCURACY_METERS=50
LOCATION_MAX_AGE_SECONDS=120
# 8080 is used by tools such as Jenkins/Sonar; change it here and point the Vite
# proxy at the same port (VITE_PROXY_TARGET) if it is taken.
SERVER_PORT=8080
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# --- Sign-in abuse protection ----------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- First administrator (used only while the admins table is empty) --------
# Created on the first backend start, then ignored. Sign in at /admin/login and
# change the password, or remove these three lines.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-at-least-12-chars
DEFAULT_ADMIN_NAME=Administrator
