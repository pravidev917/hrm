# HRM backend production environment — TEMPLATE ONLY.
#
# Copy to /etc/hrm/backend.env on the server, fill in the values there, then:
#   sudo chown root:hrm /etc/hrm/backend.env
#   sudo chmod 640 /etc/hrm/backend.env
# Never commit the filled-in file. The application reads it through systemd's
# EnvironmentFile directive, not from the repository.

# --- Database (already provisioned: hrm_prod / hrm_app) ---------------------
# DB_URL stays a JDBC URL: this is exactly what Spring Boot consumes and it must
# not be rewritten. The operations scripts (backup/restore) parse the host, port
# and database out of it and hand them to libpq as PGHOST/PGPORT/PGDATABASE, so
# no second copy of the connection settings is needed.
# DB_PASSWORD is read by those scripts into a 0600 temporary PGPASSFILE; it is
# never passed on a command line and never logged.
DB_URL=jdbc:postgresql://127.0.0.1:5432/hrm_prod
DB_USERNAME=hrm_app
DB_PASSWORD=
# validate is enforced by the prod profile as well; keep it explicit.
DB_DDL_AUTO=validate
DB_POOL_SIZE=8
JPA_SHOW_SQL=false

# --- Authentication ---------------------------------------------------------
# Generate with: openssl rand -base64 48   (minimum 32 bytes, enforced at boot)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Cookie / timezone ------------------------------------------------------
# Secure cookies require HTTPS. Keep false only until the certificate exists.
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
APP_TIMEZONE=Asia/Kolkata

# --- Same-origin deployment -------------------------------------------------
# The site and the API share one hostname (nginx proxies /api), so browser
# requests carry no Origin header and CORS is not exercised. Setting the real
# origin here only protects against a future separated frontend.
CORS_ALLOWED_ORIGINS=https://__DOMAIN__
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- Login abuse protection -------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Logging ----------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# --- First administrator ----------------------------------------------------
# Only used while the admins table is empty (first boot of a fresh database).
# Minimum 12 characters. Remove both lines after the first sign-in.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Administrator
