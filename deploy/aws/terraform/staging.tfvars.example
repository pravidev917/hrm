# Staging stack: reachable only through SSM port forwarding to http://localhost:8080.
# No Elastic IP, no public listeners, no TLS, no domain.
#
#   terraform init -backend-config=backend.staging.hcl
#   terraform apply -var-file=staging.tfvars
#
# Localhost is the point: developers port-forward and hit http://localhost:8080.
aws_region  = "ap-south-1"
project     = "hrm"
environment = "staging"

# The ECR repositories are created once by the production stack.
manage_ecr  = false
create_eip  = false
ssh_cidr    = ""
http_cidr   = ""

instance_type  = "t3.small"
root_volume_gb = 20

db_name                  = "hrm"
db_user                  = "hrm_admin"
db_engine_version        = "16.4"
db_instance_class        = "db.t4g.micro"
db_allocated_storage     = 20
db_multi_az              = false
db_backup_retention_days = 1     # enough to undo a bad migration, cheap
db_deletion_protection   = false # staging must be destroyable
ecr_keep_images          = 15

# Leave empty to let Terraform generate them; read them back from
# /hrm/staging/DB_PASSWORD and /hrm/staging/JWT_SECRET.
db_password = ""
jwt_secret  = ""
