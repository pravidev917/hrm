# /etc/hrm/backend.env on the STAGING instance (root:hrm 0640).
#
# Staging is reached only through SSM port forwarding to http://localhost:8080,
# so it runs over plain HTTP and must NOT use the prod profile (that profile
# forces Secure cookies, which a browser silently drops over http).
# Copy to the instance, fill in the blanks, then:
#   sudo install -m 0640 -o root -g hrm staging.backend.env /etc/hrm/backend.env

# --- Database (staging RDS: hrm-staging-pg) ---------------------------------
DB_URL=jdbc:postgresql://<staging-db-endpoint>:5432/hrm
DB_USERNAME=hrm_admin
DB_PASSWORD=
DB_DDL_AUTO=validate
DB_POOL_SIZE=8
JPA_SHOW_SQL=false

# --- Authentication ---------------------------------------------------------
# aws ssm get-parameter --name /hrm/staging/JWT_SECRET --with-decryption
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Cookie / timezone ------------------------------------------------------
# http://localhost cannot carry a Secure cookie.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
APP_TIMEZONE=Asia/Kolkata

# --- Same-origin ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=staging
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SERVER_PORT=8080

# --- Login abuse protection -------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Logging ----------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# --- First administrator (only while the admins table is empty) --------------
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Staging Administrator
