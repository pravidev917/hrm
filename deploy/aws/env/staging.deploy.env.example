# /opt/hrm/deploy.env on the STAGING instance (root only, 0640).
# Non-secret defaults read by deploy/aws/deploy-remote.sh.
ECR_REGISTRY=<account-id>.dkr.ecr.ap-south-1.amazonaws.com
WEB_PORT=8080
# Loopback only: the container is reachable from the instance, and from your
# laptop through SSM port forwarding. No public listener, no security-group rule.
WEB_BIND=127.0.0.1
AWS_REGION=ap-south-1
