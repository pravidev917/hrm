# /etc/hrm/backend.env on the PRODUCTION instance (root:hrm 0640).
#
# Served over HTTPS behind the ALB or host nginx, so the prod profile applies:
# it forces Secure cookies and ddl-auto=validate.
#   sudo install -m 0640 -o root -g hrm production.backend.env /etc/hrm/backend.env

# --- Database (production RDS: hrm-production-pg, isolated from staging) ----
DB_URL=jdbc:postgresql://<production-db-endpoint>:5432/hrm
DB_USERNAME=hrm_admin
DB_PASSWORD=
DB_DDL_AUTO=validate
DB_POOL_SIZE=8
JPA_SHOW_SQL=false

# --- Authentication ---------------------------------------------------------
# aws ssm get-parameter --name /hrm/production/JWT_SECRET --with-decryption
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Cookie / timezone ------------------------------------------------------
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
APP_TIMEZONE=Asia/Kolkata

# --- Same-origin ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=https://__DOMAIN__
SERVER_PORT=8080

# --- Login abuse protection -------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Logging ----------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# --- First administrator (only while the admins table is empty) --------------
# Remove both lines after the first successful sign-in.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Administrator
