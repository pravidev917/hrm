# HRM backend systemd unit — TEMPLATE. Install with:
#   sudo cp deploy/systemd/hrm-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable hrm-backend
#
# Runs as the dedicated non-login user "hrm" (not ubuntu). Create it with:
#   sudo useradd --system --shell /usr/sbin/nologin --home /opt/hrm hrm

[Unit]
Description=HRM backend (Spring Boot)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=hrm
Group=hrm
WorkingDirectory=/opt/hrm/backend
EnvironmentFile=/etc/hrm/backend.env
Environment=TZ=Asia/Kolkata

# t3.small budget: 256 MB heap / 768 MB max / 256 MB metaspace (see PRODUCTION.md).
ExecStart=/usr/bin/java \
  -Xms256m -Xmx768m -XX:MaxMetaspaceSize=256m \
  -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError \
  -Duser.timezone=Asia/Kolkata \
  -Dfile.encoding=UTF-8 \
  -jar /opt/hrm/backend/backend.jar

ExecStop=/bin/kill -TERM $MAINPID
SuccessExitStatus=143
TimeoutStopSec=30
Restart=always
RestartSec=5
LimitNOFILE=65535

# stdout -> journald. tail with: journalctl -u hrm-backend -f
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/
ProtectHome=true
# Allow the app to read its config and nothing else needs writes.
ReadWritePaths=/opt/hrm/backend /var/backups/hrm

[Install]
WantedBy=multi-user.target