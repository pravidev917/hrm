# /opt/hrm/deploy.env on the PRODUCTION Oracle VM (root 0640).
# Read by deploy/oracle/deploy-remote.sh and interpolated into docker compose.
IMAGE_REGISTRY=ghcr.io/pravidev917
API_DOMAIN=api.<your-domain>
ACME_EMAIL=ops@<your-domain>
BACKEND_MEMORY=1500m

# Only needed while the GHCR packages are private (see the staging example).
# GHCR_USER=<github-user>
# GHCR_TOKEN=<read-only PAT with read:packages>
