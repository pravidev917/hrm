# /opt/hrm/deploy.env on the STAGING Oracle VM (root 0640).
# Read by deploy/oracle/deploy-remote.sh and interpolated into docker compose.
IMAGE_REGISTRY=ghcr.io/pravidev917
API_DOMAIN=api-staging.<your-domain>
ACME_EMAIL=ops@<your-domain>
BACKEND_MEMORY=1200m

# Only needed while the GHCR packages are private. Prefer making them public:
# GitHub -> Packages -> the package -> Package settings -> Change visibility.
# GHCR_USER=<github-user>
# GHCR_TOKEN=<read-only PAT with read:packages>
