# /etc/hrm/backend.env on the PRODUCTION Oracle VM (root:hrm 0640).
#
# Install:  sudo install -m 0640 -o root -g hrm production.backend.env /etc/hrm/backend.env
#
# Production = its own Supabase project + its own VM + the Vercel production
# domain. Nothing is shared with staging except the image contract.

# --- Database: Supabase (session pooler, IPv4, TLS) --------------------------
# Use a dedicated role instead of postgres if you create one:
#   create role hrm_app login password '...'; grant ... ; (run in the SQL editor)
DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<production-project-ref>
DB_PASSWORD=
DB_DDL_AUTO=validate
DB_POOL_SIZE=8
JPA_SHOW_SQL=false

# --- Authentication ---------------------------------------------------------
# Generate: openssl rand -base64 48   (must differ from staging)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Cookie: cross-site, Vercel UI -> this API ---------------------------------
COOKIE_SECURE=true
COOKIE_SAME_SITE=None
APP_TIMEZONE=Asia/Kolkata

# --- Cross-origin rules -----------------------------------------------------
# Exactly the production UI origin(s). Nothing else.
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=https://<your-domain>
SERVER_PORT=8080

# --- Login abuse protection -------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Logging ----------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# --- First administrator (only while the admins table is empty) --------------
# Remove both after the first successful sign-in.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Administrator
