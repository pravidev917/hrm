# /etc/hrm/backend.env on the STAGING Oracle VM (root:hrm 0640).
#
# Install:  sudo install -m 0640 -o root -g hrm staging.backend.env /etc/hrm/backend.env
#
# Staging = Supabase project "hrm-staging" + this VM + the Vercel preview/staging
# domain. It is a real HTTPS origin (Caddy), so cookies are Secure - the browser
# will not send a non-Secure cookie to a different origin than the Vercel page.

# --- Database: Supabase (session pooler, IPv4, TLS) --------------------------
# Dashboard -> Project Settings -> Database -> Connection pooling (Session, 5432)
DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<staging-project-ref>
DB_PASSWORD=
DB_DDL_AUTO=validate
DB_POOL_SIZE=5
JPA_SHOW_SQL=false

# --- Authentication ---------------------------------------------------------
# Generate: openssl rand -base64 48   (must differ from production)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Cookie: cross-site, because the UI is on Vercel and the API here -------
# SameSite=None requires Secure, and Secure requires HTTPS (Caddy provides it).
COOKIE_SECURE=true
COOKIE_SAME_SITE=None
APP_TIMEZONE=Asia/Kolkata

# --- Cross-origin rules -----------------------------------------------------
# The exact origins of the Vercel deployment. Add the stable staging domain and,
# if you test previews, that preview URL too. No trailing slash, no wildcards.
SPRING_PROFILES_ACTIVE=staging
CORS_ALLOWED_ORIGINS=https://hrm-staging.vercel.app,https://staging.<your-domain>
SERVER_PORT=8080

# --- Login abuse protection -------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Logging ----------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# --- First administrator (only while the admins table is empty) --------------
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Staging Administrator
